[Unit]
Description=Mycelium code intelligence daemon
After=docker.service

[Service]
Type=simple
WorkingDirectory=__REPO__
ExecStart=__BINARY_PATH__ run
Restart=on-failure
RestartSec=5
StandardOutput=append:__LOG_PATH__
StandardError=append:__LOG_PATH__
Environment=PATH=__MISE_SHIMS__:/usr/local/bin:/usr/bin:/bin
Environment=MYCEL_REPO=__REPO__

[Install]
WantedBy=default.target
